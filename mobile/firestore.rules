rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Admins are users/{uid} docs with role == 'admin'. Used to grant the
    // admin dashboard read access across collections it doesn't own.
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // True if the caller and toUid are exactly the buyer and seller (in
    // either direction) on orders/{orderId}. Used to stop a signed-in user
    // from spoofing an order_placed/order_cancelled notification to an
    // arbitrary real user.
    function isOrderParty(orderId, toUid) {
      let order = get(/databases/$(database)/documents/orders/$(orderId)).data;
      return (order.buyerUid == request.auth.uid && order.sellerUid == toUid) ||
        (order.sellerUid == request.auth.uid && order.buyerUid == toUid);
    }

    // True if `order` matches offers/{order.offerId} as it will be after this write/transaction:
    // offer accepted, same buyer/seller/listing, and the order price is the offered price
    // with payment still pending.
    function isAcceptedOfferOrder(order) {
      let before = get(/databases/$(database)/documents/offers/$(order.offerId)).data;
      let after = getAfter(/databases/$(database)/documents/offers/$(order.offerId)).data;
      return before.status == 'pending' &&
        after.status == 'accepted' &&
        after.sellerUid == request.auth.uid &&
        after.buyerUid == order.buyerUid &&
        after.listingId == order.listingId &&
        order.totalPrice == after.offeredPrice &&
        order.paymentStatus == 'pending';
    }

    // True if `order` is a plain purchase of an available listing at the listing's own seller and price.
    function isDirectPurchaseOfListing(order) {
      let listing = get(/databases/$(database)/documents/marketplace/$(order.listingId)).data;
      return listing.status == 'available' &&
        order.sellerUid == listing.sellerUid &&
        order.totalPrice == listing.totalPrice;
    }

    // If binLocation is being set it must be a real coordinate pair.
    function isValidBinLocation() {
      return !('binLocation' in request.resource.data) ||
        (request.resource.data.binLocation is map &&
          request.resource.data.binLocation.keys().hasOnly(['latitude', 'longitude']) &&
          request.resource.data.binLocation.latitude is number &&
          request.resource.data.binLocation.longitude is number &&
          request.resource.data.binLocation.latitude >= -90 && request.resource.data.binLocation.latitude <= 90 &&
          request.resource.data.binLocation.longitude >= -180 && request.resource.data.binLocation.longitude <= 180);
    }

    // users/{uid} - profile doc, keyed by the account's own auth uid.
    // Private: only the owner and admins can read it (it holds email/phone/address). Buyer and
    // seller names shown to each other come from the names copied onto listings, offers and orders.
    // Sign-up may only create a seller or buyer profile (an admin is made by hand in the console),
    // and the owner can only edit their own contact details, never role, points, `disabled` or `binId` (they may set `binLocation`, where their bin is)
    // (an admin assigns which smart bin a seller sees).
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) &&
        request.resource.data.role in ['seller', 'buyer'] &&
        !('disabled' in request.resource.data) &&
        !('points' in request.resource.data);
      allow update: if
        (isOwner(uid) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['fullName', 'phone', 'location', 'photoURL', 'updatedAt', 'binLocation']) &&
          isValidBinLocation()) ||
        (isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disabled', 'binId']) &&
          (!('binId' in request.resource.data) ||
            (request.resource.data.binId is string && request.resource.data.binId.matches('^[A-Za-z0-9_-]{1,32}$'))));
      allow delete: if false;
    }

    // bins/{uid} - IoT sensor readings, keyed by the seller's own uid. Never read by buyers directly
    // (marketplace listings snapshot the location/weight they need at creation time).
    match /bins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);
    }

    // True if this update is a buyer buying the listing: available -> sold, in the same write
    // (batch/transaction) that creates their own order for it. `soldOrderId` records which order
    // bought it, so a later cancel can be tied back to that order.
    function isBuyingListing(listingId) {
      let orderPath = /databases/$(database)/documents/orders/$(request.resource.data.soldOrderId);
      return resource.data.status == 'available' &&
        request.resource.data.status == 'sold' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'soldOrderId']) &&
        !exists(orderPath) &&
        existsAfter(orderPath) &&
        getAfter(orderPath).data.buyerUid == request.auth.uid &&
        getAfter(orderPath).data.listingId == listingId;
    }

    // True if this update puts a sold listing back on the market because its buyer cancelled the
    // order that bought it, in the same write that marks that order cancelled.
    function isRestoringListing(listingId) {
      let orderPath = /databases/$(database)/documents/orders/$(resource.data.soldOrderId);
      return resource.data.status == 'sold' &&
        request.resource.data.status == 'available' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'soldOrderId']) &&
        !('soldOrderId' in request.resource.data) &&
        get(orderPath).data.status != 'cancelled' &&
        getAfter(orderPath).data.status == 'cancelled' &&
        getAfter(orderPath).data.buyerUid == request.auth.uid &&
        getAfter(orderPath).data.listingId == listingId;
    }

    function isPositiveNumber(v) {
      return v is number && v > 0;
    }

    // A new listing must be well-formed: a known waste type, a positive weight and price within
    // sane limits, a map location, and it starts available (never pre-marked sold).
    function isValidNewListing(d) {
      return d.wasteType in ['plastic', 'food', 'metal'] &&
        isPositiveNumber(d.weightKg) && d.weightKg <= 10000 &&
        isPositiveNumber(d.totalPrice) && d.totalPrice <= 10000000 &&
        d.status == 'available' &&
        !('soldOrderId' in d) &&
        d.sellerName is string &&
        d.location.latitude is number && d.location.longitude is number;
    }

    // When the seller edits their own listing, the owner can't change, status must stay a known
    // value, and a changed weight/price must still be a sane positive number.
    function isValidListingEdit() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return request.resource.data.sellerUid == resource.data.sellerUid &&
        request.resource.data.status in ['available', 'sold'] &&
        (!changed.hasAny(['weightKg']) || (isPositiveNumber(request.resource.data.weightKg) && request.resource.data.weightKg <= 10000)) &&
        (!changed.hasAny(['totalPrice']) || (isPositiveNumber(request.resource.data.totalPrice) && request.resource.data.totalPrice <= 10000000)) &&
        (!changed.hasAny(['wasteType']) || request.resource.data.wasteType in ['plastic', 'food', 'metal']);
    }

    // marketplace/{listingId} - waste listings. Any signed-in user can browse them.
    // The seller who created a listing can create/edit/delete it. A buyer can only change a
    // listing as part of buying it or cancelling that purchase (see the two functions above) -
    // they can no longer flip anyone's listing to sold on their own.
    match /marketplace/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.sellerUid == request.auth.uid &&
        isValidNewListing(request.resource.data);
      allow update: if isSignedIn() && (
        (resource.data.sellerUid == request.auth.uid && isValidListingEdit()) ||
        isBuyingListing(listingId) ||
        isRestoringListing(listingId)
      );
      allow delete: if isSignedIn() && (resource.data.sellerUid == request.auth.uid || isAdmin());
    }

    // orders/{orderId} - purchases. Only the buyer or seller involved can see or touch an order.
    // The buyer-side "cancel order" flow (BuyerOrders.tsx) marks the order cancelled via update
    // rather than deleting it, so history/evidence survives a cancellation — deletion is
    // disabled entirely.
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.buyerUid == request.auth.uid || resource.data.sellerUid == request.auth.uid || isAdmin()
      );
      // Either the buyer places a direct purchase, or the seller creates the order while
      // accepting a buyer's offer (SellerOffers.tsx). The seller path is only allowed when
      // the order mirrors an offer that this same transaction flips to 'accepted' (getAfter),
      // so a seller can't invent an order for an arbitrary buyer or price.
      // A direct purchase must match the real listing: its seller, its price, and still available.
      allow create: if isSignedIn() && (
        (
          request.resource.data.buyerUid == request.auth.uid &&
          !('offerId' in request.resource.data) &&
          isDirectPurchaseOfListing(request.resource.data)
        ) ||
        (
          request.resource.data.sellerUid == request.auth.uid &&
          'offerId' in request.resource.data &&
          isAcceptedOfferOrder(request.resource.data)
        )
      );
      // Updates are limited to specific transitions, and never touch price, parties or listing:
      //  - buyer cancels their own unpaid, not-yet-completed order
      //  - buyer pays an accepted-offer order by card (payment fields only)
      //  - seller moves the order status forward, or marks a cash order paid when collected
      //  - buyer rates a completed order once (rating only)
      //  - admin changes status only
      allow update: if isSignedIn() && (
        (
          resource.data.buyerUid == request.auth.uid &&
          resource.data.status in ['pending', 'confirmed'] &&
          resource.data.paymentStatus == 'pending' &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
        ) ||
        (
          resource.data.buyerUid == request.auth.uid &&
          'offerId' in resource.data &&
          resource.data.paymentStatus == 'pending' &&
          request.resource.data.paymentMethod == 'card' &&
          request.resource.data.paymentStatus == 'paid' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['paymentMethod', 'paymentStatus', 'paymentLast4'])
        ) ||
        (
          resource.data.sellerUid == request.auth.uid &&
          resource.data.status != 'cancelled' &&
          request.resource.data.status in ['confirmed', 'completed', 'cancelled'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
        ) ||
        (
          resource.data.sellerUid == request.auth.uid &&
          resource.data.paymentMethod == 'cash' &&
          resource.data.paymentStatus == 'pending' &&
          request.resource.data.paymentStatus == 'paid' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus'])
        ) ||
        (
          // buyer rates a completed order once, 1-5 stars
          resource.data.buyerUid == request.auth.uid &&
          resource.data.status == 'completed' &&
          !('rating' in resource.data) &&
          request.resource.data.rating is int &&
          request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating'])
        ) ||
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );
      allow delete: if false;
    }

    // notifications/{id} - only the recipient can read or mark their own notification.
    // The app writes these for two cases: a self-notification ("bin_full", toUid == the
    // creator's own uid) and an order event sent to the other party, carrying an `orderId`
    // so isOrderParty() can confirm the sender and recipient are actually the buyer/seller
    // on that order — this blocks a signed-in user from spoofing a notification to an
    // arbitrary real user.
    // Offer notifications (offer_received, offer_accepted, offer_rejected) carry an `offerId`
    // so the sender/recipient can be verified against the offers collection.
    function isOfferParty(offerId, toUid) {
      let offer = get(/databases/$(database)/documents/offers/$(offerId)).data;
      return (offer.buyerUid == request.auth.uid && offer.sellerUid == toUid) ||
        (offer.sellerUid == request.auth.uid && offer.buyerUid == toUid);
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn() && (resource.data.toUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasAll(['toUid', 'type', 'message', 'read', 'createdAt']) &&
        request.resource.data.read == false &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.toUid)) &&
        (
          (request.resource.data.type == 'bin_full' && request.resource.data.toUid == request.auth.uid) ||
          (
            request.resource.data.type in ['order_placed', 'order_cancelled'] &&
            'orderId' in request.resource.data &&
            exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId)) &&
            isOrderParty(request.resource.data.orderId, request.resource.data.toUid)
          ) ||
          (
            request.resource.data.type in ['offer_received', 'offer_accepted', 'offer_rejected'] &&
            'offerId' in request.resource.data &&
            exists(/databases/$(database)/documents/offers/$(request.resource.data.offerId)) &&
            isOfferParty(request.resource.data.offerId, request.resource.data.toUid)
          )
        );
      allow update: if isSignedIn() && resource.data.toUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.toUid == request.auth.uid;
    }

    // offers/{offerId} - buyer-submitted price offers for marketplace listings.
    // Buyers create their own offers and can withdraw (status→withdrawn) pending ones.
    // Sellers can read offers for their listings and accept/reject them.
    // Acceptance/rejection happens client-side; the transaction is trusted because
    // the seller must own the listing referenced by listingId.
    match /offers/{offerId} {
      allow read: if isSignedIn() && (
        resource.data.buyerUid == request.auth.uid ||
        resource.data.sellerUid == request.auth.uid ||
        isAdmin()
      );
      // Buyer creates an offer for themselves — sellerUid must match the listing's seller.
      allow create: if isSignedIn() &&
        request.resource.data.buyerUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.offeredPrice is number &&
        request.resource.data.offeredPrice > 0 &&
        exists(/databases/$(database)/documents/marketplace/$(request.resource.data.listingId)) &&
        get(/databases/$(database)/documents/marketplace/$(request.resource.data.listingId)).data.sellerUid ==
          request.resource.data.sellerUid &&
        get(/databases/$(database)/documents/marketplace/$(request.resource.data.listingId)).data.status == 'available';
      // Buyer may only withdraw their own pending offer.
      // Seller may accept/reject their own listing's offer.
      allow update: if isSignedIn() && (
        (
          resource.data.buyerUid == request.auth.uid &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'withdrawn' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        ) ||
        (
          resource.data.sellerUid == request.auth.uid &&
          resource.data.status == 'pending' &&
          request.resource.data.status in ['accepted', 'rejected'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        ) ||
        // Allow a seller's acceptance flow to also reject other pending offers for their listing
        (
          resource.data.sellerUid == request.auth.uid &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'rejected' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        ) ||
        isAdmin()
      );
      allow delete: if false;
    }

    // users/{uid} read stays open to any signed-in user (see above); nothing extra needed for isAdmin here.
  }
}
